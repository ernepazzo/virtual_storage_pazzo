<div id="cart" data-controller="cart" data-cart-target="container">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
      <h6 class="mb-0"><i class="bi bi-cart3"></i> Carrito de Ventas</h6>
    </div>

    <div class="card-body p-0">
      <% if cart.cart_items.any? %>
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
          <tr>
            <th>Producto</th>
            <th>Cant.</th>
            <th>Total</th>
            <th></th>
          </tr>
          </thead>
          <tbody>
          <% cart.cart_items.each do |item| %>
            <tr>
              <td><%= item.product_item.name %></td>
              <td>
                <input type="number" min="1" value="<%= item.quantity %>"
                       data-id="<%= item.id %>"
                       data-action="change->cart#updateQuantity"
                       data-cart-target="cartCount"
                       class="form-control form-control-sm text-center">
              </td>
              <!--              <td><%#= number_to_currency(item.total_price) %></td>-->
              <td><%= number_to_currency(item.total_price, unit: '$', separator: ',', format: '%u%n') %></td>
              <td>
                <button data-id="<%= item.id %>" data-action="click->cart#remove"
                        class="btn btn-sm btn-outline-danger">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="text-center p-4 text-muted">🛒 No hay productos en el carrito</div>
      <% end %>
    </div>

    <% if cart.cart_items.any? %>
      <div class="card-footer d-flex justify-content-between align-items-center">
        <!--        <h5 class="mb-0 fw-bold">Total: <%#= number_to_currency(cart.total) %></h5>-->
        <h5 class="mb-0 fw-bold">Total: <%= number_to_currency(cart.total, unit: '$', separator: ',', format: '%u%n') %></h5>
        <%= button_to "Finalizar Venta", seller_sales_path,
                      method: :post, class: "btn btn-success btn-sm" %>
      </div>
    <% end %>
  </div>
</div>
