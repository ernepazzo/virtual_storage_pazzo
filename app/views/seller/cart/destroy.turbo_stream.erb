<%= turbo_stream.replace "cart" do %>
  <%= render "seller/cart/cart", cart: @cart %>
<% end %>

<%= turbo_stream.append "flash" do %>
  <div class="alert alert-warning alert-dismissible fade show position-fixed top-0 end-0 m-3 shadow"
       style="z-index: 9999; animation: fadeInDown 0.4s;">
    <i class="bi bi-trash me-2"></i> Producto eliminado del carrito
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% end %>

<script>
    const cartEl = document.getElementById("cart");
    if (cartEl) {
        cartEl.classList.add("animate-fadeout");
        setTimeout(() => cartEl.classList.remove("animate-fadeout"), 600);
    }
</script>
