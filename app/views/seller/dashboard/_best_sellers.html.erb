<ul class="list-group list-group-flush" id="best-sellers">
  <% @top_products.each do |p| %>
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <%= p.name %>
      <span class="badge bg-primary"># productos: <%= p.total_quantity_sold %></span>
      <span class="badge bg-primary"># ventas: <%= p.sales_count %></span>
    </li>
  <% end %>
</ul>